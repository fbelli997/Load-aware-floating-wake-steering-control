@article{Ebrahimi_2026,
doi = {10.1088/1742-6596/3224/3/032133},
url = {https://doi.org/10.1088/1742-6596/3224/3/032133},
year = {2026},
month = {may},
publisher = {IOP Publishing},
volume = {3224},
number = {3},
pages = {032133},
author = {Ebrahimi, Majid and Bellini, Federico and Fontanella, Alessandro and Ambrosini, Simone and Muggiasca, Sara and Belloli, Marco},
title = {Transfer Learning for Centralized Deep Reinforcement Learning Wind Farm Control with FLORIS and FAST.Farm},
journal = {Journal of Physics: Conference Series},
abstract = {Wake steering is a promising wind-farm control strategy for increasing total power production by intentionally yawing upstream turbines to redirect their wakes away from downstream machines. While low-fidelity engineering models enable efficient controller development, they cannot fully capture the wake dynamics and turbine interactions represented by higher-fidelity simulators. This limitation is particularly relevant for floating offshore wind farms, where wake behaviour is further influenced by platform motion and is generally more difficult to model than in bottom-fixed installations. This work presents a transfer-learning framework for centralized reinforcement-learning-based wake steering, built on the existing Wind Farm Control Reinforcement Learning (WFCRL) framework. The main contribution is the introduction of a centralized RL algorithm into WFCRL through a unified RL environment, enabling a consistent observation–action interface across simulation fidelities. In addition, for the IEA 15 MW reference wind turbine controlled by ROSCO, a ZeroMQ-based communication interface is developed and integrated into the WFCRL environment to exchange measurements and yaw-control commands between the RL agent and the simulator. This results in a unified workflow that connects FLORIS, FAST.Farm, and WFCRL for transfer learning in wind-farm wake steering. A centralized policy is first trained in FLORIS and then transferred to FAST.Farm for implementation and subsequent fine-tuning on a four-turbine floating wind-farm layout based on the IEA 15 MW turbine. The results show that low-fidelity pre-training provides an effective initialization for higher-fidelity learning. Policy implementation in FAST.Farm increases mean farm power by 7.5% relative to the greedy baseline, while subsequent fine-tuning in FAST.Farm raises the gain to 8.75%, corresponding to a further 1.25% improvement.}
}


@article{Bellini_2026,
doi = {10.1088/1742-6596/3224/3/032081},
url = {https://doi.org/10.1088/1742-6596/3224/3/032081},
year = {2026},
month = {may},
publisher = {IOP Publishing},
volume = {3224},
number = {3},
pages = {032081},
author = {Bellini, Federico and Ebrahimi, Majid and Giuseppe, Pierpaolo Di and Fontanella, Alessandro and Muggiasca, Sara and Belloli, Marco},
title = {Closed-loop Wind farm control for floating turbines via online yaw and induction setpoint optimization},
journal = {Journal of Physics: Conference Series},
abstract = {This paper investigates closed-loop wind-farm control for floating wind turbines via online setpoint optimization of yaw setpoints for wake steering and turbine derating for induction control. A FLORIS-based supervisory controller is coupled to a mid-fidelity floating wind-farm plant simulated in FAST.Farm through a ZeroMQ interface. Model–plant mismatch is handled through two alternative, separately evaluated approaches: (i) calibration of the FLORIS wake and turbulence response against FAST.Farm (including a rank-dependent attenuation to match downstream wake-added turbulence trends), and (ii) a turbine-wise Gaussian Process Regression (GPR) residual model enabled in selected closed-loop (CL) cases. A four-turbine weakly staggered farm is assessed under turbulent inflow and operational events (turbine shutdowns and time-varying wind direction), and closed-loop performance is benchmarked against lookup-table policies. Results show consistent power gains over greedy control (approximately 10—12% for wake steering and about 16% for induction in the tested condition), with CL providing systematic advantages under shutdown scenarios, while GPR yields mixed benefits under turbulent CL operation.}
}


